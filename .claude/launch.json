{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dubber",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "app.py"
      ],
      "port": 5000
    },
    {
      "name": "dubber-test",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import app; app.app.run(port=5055, debug=False)"
      ],
      "port": 5055
    }
  ]
}